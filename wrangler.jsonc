{
  "name": "line",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build/web",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
